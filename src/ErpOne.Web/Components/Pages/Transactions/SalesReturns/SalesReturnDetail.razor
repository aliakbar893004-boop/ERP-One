@page "/transactions/sales-returns/{Id:int}"
@attribute [Authorize(Policy = "transactions.sales-returns.index")]
@rendermode InteractiveServer
@using FluentValidation
@using ErpOne.Application.Approvals
@using ErpOne.Application.Sales.SalesReturns
@inject ISalesReturnService Returns
@inject IAuthorizationService Auth
@inject SwalService Swal
@inject NavigationManager Nav

<PageTitle>@(_r?.ReturnNumber ?? "Sales Return")</PageTitle>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else if (_r is null)
{
    <div class="pf pf-detail"><div class="pf-alert err"><i class="bi bi-exclamation-octagon"></i> Return not found.</div></div>
}
else
{
    <div class="pf pf-detail">
        <div class="pf-top">
            <div class="crumbs"><a href="/transactions/sales-returns">Sales Return</a><i class="bi bi-chevron-right"></i><span class="here">@_r.ReturnNumber</span></div>
        </div>
        <div class="pd-head">
            <h1>@_r.ReturnNumber</h1>
            <span class="badge @StatusClass(_r.Status)">@_r.Status</span>
            <div class="actions">
                @if (_r.Status == "Draft")
                {
                    <AuthorizeView Policy="transactions.sales-returns.edit"><Authorized>
                        <a class="btn btn-line btn-sm" href="@($"/transactions/sales-returns/{_r.Id}/edit")"><i class="bi bi-pencil"></i> Edit</a>
                    </Authorized></AuthorizeView>
                    <AuthorizeView Policy="transactions.sales-returns.delete"><Authorized>
                        <button class="btn btn-danger btn-sm" @onclick="DeleteAsync" disabled="@_busy"><i class="bi bi-trash3"></i> Delete</button>
                    </Authorized></AuthorizeView>
                    <AuthorizeView Policy="transactions.sales-returns.post"><Authorized>
                        <button class="btn btn-primary btn-sm" @onclick="SubmitAsync" disabled="@_busy"><i class="bi bi-send"></i> Submit</button>
                    </Authorized></AuthorizeView>
                }
                @if (_r.Status == "PendingApproval" && _canApprove)
                {
                    <button class="btn btn-ok btn-sm" @onclick="ApproveAsync" disabled="@_busy"><i class="bi bi-check2-circle"></i> Approve</button>
                    <button class="btn btn-danger btn-sm" @onclick="@(() => _showReject = true)" disabled="@_busy"><i class="bi bi-x-circle"></i> Reject</button>
                }
            </div>
        </div>

        @if (_error is not null) { <div class="pf-alert err"><i class="bi bi-exclamation-octagon"></i> @_error</div> }

        @if (_showReject)
        {
            <section class="card danger">
                <div class="card-b">
                    <textarea class="ctl" rows="2" placeholder="Rejection reason" @bind="_rejectReason"></textarea>
                    <div class="row-end">
                        <button class="btn btn-ghost btn-sm" @onclick="@(() => _showReject = false)">Cancel</button>
                        <button class="btn btn-danger btn-sm" @onclick="RejectAsync" disabled="@_busy">Reject return</button>
                    </div>
                </div>
            </section>
        }

        <section class="card">
            <div class="card-h"><span class="hd-ic"><i class="bi bi-arrow-return-right"></i></span><h2>Return</h2></div>
            <div class="card-b">
                <div class="info-grid">
                    <div class="info-cell"><span class="k"><i class="bi bi-calendar3"></i> Date</span><span class="v">@_r.ReturnDate.ToString("d MMM yyyy")</span></div>
                    <div class="info-cell"><span class="k"><i class="bi bi-person-vcard"></i> Customer</span><span class="v">@_r.CustomerName</span></div>
                    <div class="info-cell"><span class="k"><i class="bi bi-diagram-2"></i> Source</span><span class="v">@_r.SourceType@(_r.DoNumber is null ? "" : $" · {_r.DoNumber}")@(_r.InvoiceNumber is null ? "" : $" · {_r.InvoiceNumber}")</span></div>
                    @if (!string.IsNullOrWhiteSpace(_r.Notes)) { <div class="info-cell wide"><span class="k"><i class="bi bi-sticky"></i> Notes</span><span class="v">@_r.Notes</span></div> }
                    @if (!string.IsNullOrWhiteSpace(_r.RejectionNote)) { <div class="info-cell wide reject"><span class="k"><i class="bi bi-exclamation-triangle"></i> Rejection note</span><span class="v">@_r.RejectionNote</span></div> }
                </div>
            </div>
        </section>

        <section class="card">
            <div class="card-h"><span class="hd-ic"><i class="bi bi-list-ul"></i></span><h2>Lines</h2></div>
            <div class="card-b">
                <table class="items">
                    <thead><tr><th>Product</th><th>Warehouse</th><th class="r">Qty</th><th class="r">Unit Cost</th><th class="r">Line Total</th></tr></thead>
                    <tbody>
                        @foreach (var l in _r.Lines)
                        {
                            <tr>
                                <td><div class="prod"><span class="pn">@l.ProductName</span><span class="sku">@l.Sku</span></div></td>
                                <td>@l.WarehouseName</td>
                                <td class="r mono">@l.Quantity</td>
                                <td class="r mono">@l.UnitCost.ToString("N2")</td>
                                <td class="r mono">@l.LineTotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr><td colspan="4" class="r">Subtotal</td><td class="r mono">@_r.Subtotal.ToString("N2")</td></tr>
                        @if (_r.DiscountTotal != 0) { <tr><td colspan="4" class="r">Discount</td><td class="r mono">@_r.DiscountTotal.ToString("N2")</td></tr> }
                        @if (_r.TaxTotal != 0) { <tr><td colspan="4" class="r">Tax</td><td class="r mono">@_r.TaxTotal.ToString("N2")</td></tr> }
                        <tr><td colspan="4" class="r"><strong>Grand Total</strong></td><td class="r mono"><strong>@_r.GrandTotal.ToString("N2")</strong></td></tr>
                        <tr><td colspan="4" class="r">Inventory Value</td><td class="r mono">@_r.InventoryTotal.ToString("N2")</td></tr>
                    </tfoot>
                </table>
            </div>
        </section>

        @if (_steps.Count > 0)
        {
            <section class="card">
                <div class="card-h"><span class="hd-ic"><i class="bi bi-diagram-3"></i></span><h2>Approval</h2></div>
                <div class="card-b">
                    <ul class="tl">
                        @foreach (var s in _steps)
                        {
                            <li>
                                <span class="dot @StepDot(s.Status)"><i class="bi @StepIcon(s.Status)"></i></span>
                                <div>
                                    <div class="ti">Step @s.StepOrder · @s.RoleName</div>
                                    <div class="meta">@s.Status@(s.ActedByName is null ? "" : $" · {s.ActedByName}")</div>
                                    @if (!string.IsNullOrWhiteSpace(s.Note)) { <div class="note">@s.Note</div> }
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </section>
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private SalesReturnDto? _r;
    private IReadOnlyList<ApprovalStepDto> _steps = [];
    private bool _loading = true, _busy, _canApprove, _showReject;
    private string _rejectReason = string.Empty;
    private string? _error;
    private System.Security.Claims.ClaimsPrincipal _user = default!;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _r = await Returns.GetByIdAsync(Id);
        _steps = _r?.ApprovalSteps ?? [];
        _canApprove = await EvaluateCanApproveAsync();
        _loading = false;
    }

    private async Task<bool> EvaluateCanApproveAsync()
    {
        if (_r is null || _r.Status != "PendingApproval") return false;
        if (!(await Auth.AuthorizeAsync(_user, "transactions.sales-returns.approve")).Succeeded) return false;
        if (string.Equals(_r.CreatedBy, _user.Identity?.Name, StringComparison.OrdinalIgnoreCase)) return false;
        var current = _steps.FirstOrDefault(s => s.Status == "Pending");
        return current is not null && _user.IsInRole(current.RoleName);
    }

    private async Task SubmitAsync() => await RunAsync(() => Returns.SubmitAsync(Id), "Return submitted");
    private async Task ApproveAsync() =>
        await RunAsync(() => Returns.ApproveAsync(Id, _user.Identity?.Name ?? "", _user.IsInRole), "Return approved & posted");

    private async Task RejectAsync()
    {
        if (string.IsNullOrWhiteSpace(_rejectReason)) { _error = "Rejection reason is required."; return; }
        var reason = _rejectReason;
        _showReject = false;
        _rejectReason = string.Empty;
        await RunAsync(() => Returns.RejectAsync(Id, _user.Identity?.Name ?? "", _user.IsInRole, reason), "Return rejected, returned to Draft");
    }

    private async Task DeleteAsync()
    {
        if (!await Swal.ConfirmAsync("Delete this draft return?", "This cannot be undone.")) return;
        _error = null; _busy = true;
        try
        {
            await Returns.DeleteAsync(Id);
            await Swal.ToastAsync("success", "Return deleted");
            Nav.NavigateTo("/transactions/sales-returns");
        }
        catch (ValidationException ex) { _error = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage)); }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RunAsync(Func<Task> action, string okMsg)
    {
        _error = null; _busy = true;
        try
        {
            await action();
            await LoadAsync();
            await Swal.ToastAsync("success", okMsg);
        }
        catch (ValidationException ex) { _error = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage)); }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private static string StatusClass(string s) => s switch
    {
        "Draft" => "b-draft", "PendingApproval" => "b-warn", "Posted" => "b-done", _ => "b-dark"
    };
    private static string StepIcon(string s) => s switch { "Approved" => "bi-check-lg", "Rejected" => "bi-x-lg", _ => "bi-clock" };
    private static string StepDot(string s) => s switch { "Approved" => "ok", "Rejected" => "no", _ => "wait" };
}
